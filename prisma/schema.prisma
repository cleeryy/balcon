generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Watch {
  id                String    @id @default(cuid())
  url               String
  title             String?
  selector          String?
  ignoreRegex       String?
  intervalMin       Int       @default(30)
  active            Boolean   @default(true)
  webhookUrl        String?
  email             String?
  tags              String    @default("")
  valueRegex        String?
  discordWebhookUrl String?
  slackWebhookUrl   String?
  checkWindows      String?
  pausedUntil       DateTime?
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  nextCheckAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  snapshots   Snapshot[]
  checkLogs   CheckLog[]
  valuePoints ValuePoint[]

  @@index([ownerId])
}

model Snapshot {
  id        String   @id @default(cuid())
  watchId   String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  hash      String
  content   Bytes
  createdAt DateTime @default(now())

  @@index([watchId, createdAt])
}

model CheckLog {
  id              String   @id @default(cuid())
  watchId         String
  watch           Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  status          String
  message         String?
  durationMs      Int      @default(0)
  httpStatus      Int?
  backend         String?
  fetchMs         Int?
  parseMs         Int?
  htmlBytes       Int?
  textBytes       Int?
  selectorMatches Int?
  errorKind       String?
  contentHash     String?
  createdAt       DateTime @default(now())

  @@index([watchId, createdAt])
}

model ValuePoint {
  id        String   @id @default(cuid())
  watchId   String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  label     String   @default("value")
  value     String
  numeric   Float?
  createdAt DateTime @default(now())

  @@index([watchId, createdAt])
}

// Better Auth core (v1.7.7) + admin plugin.
// Field set derived from the pinned better-auth source
// (@better-auth/core getAuthTables + admin plugin schema).
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  watches       Watch[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

// Paramètres applicatifs modifiables via /api/admin/settings.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
